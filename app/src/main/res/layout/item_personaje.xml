<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="14dp"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/imgPersonaje"
        android:layout_width="115dp"
        android:layout_height="145dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del personaje" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del personaje"
            android:textColor="#17172B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAnime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nombre del anime"
            android:textColor="#7652D5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Descripción del personaje"
            android:textColor="#555566"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>